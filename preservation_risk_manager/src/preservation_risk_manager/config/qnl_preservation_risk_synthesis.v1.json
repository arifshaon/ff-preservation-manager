{
  "policy_id": "qnl-preservation-risk-synthesis",
  "version": "1.0",
  "description": "Governed policy for normalizing source-native preservation-risk assessments and synthesizing an overall semantic preservation risk. Missing evidence contributes nothing. Source-native values remain visible and heterogeneous numeric scales are never averaged.",
  "semantic_levels": [
    {"id": "minimal", "label": "Minimal concern", "rank": 0},
    {"id": "low", "label": "Low concern", "rank": 1},
    {"id": "moderate", "label": "Moderate concern", "rank": 2},
    {"id": "high", "label": "High concern", "rank": 3},
    {"id": "critical", "label": "Critical concern", "rank": 4}
  ],
  "terminology": {
    "mapping_authority": "source_rules",
    "unknown_term_policy": "unmapped",
    "normalization": "trim_casefold_underscore_as_space",
    "ai_output_vocabulary": "semantic_levels",
    "notes": "Source-native terminology is preserved. A term affects governed synthesis only when a matching source_rule maps it to one of semantic_levels or an already normalized semantic_level is explicitly accepted. AI-assisted synthesis returns semantic_levels directly and may discuss other terminology in rationale without changing source-native records."
  },
  "source_rules": [
    {
      "rule_id": "nara-native-risk",
      "source_match": {"source_id": "nara_digital_preservation_framework"},
      "role": "risk_assessment",
      "value_fields": ["native_label", "normalized_band", "semantic_level"],
      "value_map": {
        "low risk": "low",
        "low": "low",
        "moderate risk": "moderate",
        "moderate": "moderate",
        "high risk": "high",
        "high": "high"
      },
      "accept_existing_semantic_level": true,
      "default_scope": "exact_format"
    },
    {
      "rule_id": "dpc-global-bit-list",
      "source_match": {"source_type": "dpc_bit_list"},
      "role": "risk_assessment",
      "value_fields": ["native_label", "semantic_level"],
      "value_map": {
        "lower risk": "minimal",
        "lower-risk": "minimal",
        "vulnerable": "moderate",
        "endangered": "high",
        "critically endangered": "critical",
        "critically-endangered": "critical",
        "practically extinct": "critical",
        "practically-extinct": "critical"
      },
      "accept_existing_semantic_level": true,
      "default_scope": "format_group"
    },
    {
      "rule_id": "pre-normalized-risk-fallback",
      "source_match": {},
      "role": "risk_assessment",
      "value_fields": ["semantic_level"],
      "value_map": {},
      "accept_existing_semantic_level": true
    }
  ],
  "evidence_source_roles": [
    {"source_match": {"source_id": "loc"}, "role": "supporting_preservation_evidence", "may_create_source_overall_rating": false},
    {"source_match": {"source_type": "loc_fdd_xml"}, "role": "supporting_preservation_evidence", "may_create_source_overall_rating": false},
    {"source_match": {"source_id": "pronom"}, "role": "identity_and_identification_evidence", "may_create_source_overall_rating": false},
    {"source_match": {"source_type": "pronom"}, "role": "identity_and_identification_evidence", "may_create_source_overall_rating": false},
    {"source_match": {"source_id": "wikidata"}, "role": "context_only", "may_create_source_overall_rating": false}
  ],
  "synthesis": {
    "headline_roles": ["risk_assessment"],
    "missing_assessment_policy": "exclude",
    "unmapped_assessment_policy": "retain_for_ai_or_review",
    "scope_precedence": [
      ["exact_format", "format_version", "institutional_format"],
      ["format_family", "family"],
      ["format_group", "group"],
      ["content_type"],
      ["contextual"]
    ],
    "scope_selection": "most_specific_available",
    "same_scope_aggregation": "highest_semantic_concern",
    "broader_scope_policy": "context_only",
    "numeric_aggregation": "forbidden_across_source_scales"
  },
  "ai": {
    "version": "2.0",
    "enabled_when_ai_mode_is_on": true,
    "strategy": "capability_driven_contextual_synthesis",
    "registry_evidence_role": "primary_supplied_context",
    "governed_synthesis_role": "auditable_baseline_for_comparison",
    "allow_general_knowledge": true,
    "allow_external_knowledge": true,
    "external_capabilities_policy": "make_provider_capabilities_available_and_let_model_decide",
    "evidence_references": "preferred_for_audit_not_required_for_acceptance",
    "configured_source_mappings": "supply_as_methodology_context_not_binding_on_ai_result",
    "native_source_assessments": "preserve_and_do_not_rewrite",
    "missing_evidence_policy": "not_a_risk_signal",
    "consumer_decision_policy": "return_ai_result_alongside_governed_baseline",
    "automatic_persistence": false,
    "external_research": {
      "role": "optional_provider_capability",
      "availability": "automatic_when_provider_supports_it",
      "use_decision": "provider_or_model",
      "citations": "retain_when_returned",
      "failure_policy": "continue_ai_analysis_with_supplied_context",
      "institution_scoped_evidence_to_public_search": false
    }
  }
}
