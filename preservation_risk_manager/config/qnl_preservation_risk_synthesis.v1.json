{
  "policy_id": "qnl-preservation-risk-synthesis",
  "version": "1.0",
  "description": "Governed policy for normalizing source-native preservation-risk assessments and synthesizing an overall semantic preservation risk. Missing evidence contributes nothing. Source-native values remain visible and heterogeneous numeric scales are never averaged.",
  "semantic_levels": [
    {"id": "minimal", "label": "Minimal concern", "rank": 0},
    {"id": "low", "label": "Low concern", "rank": 1},
    {"id": "moderate", "label": "Moderate concern", "rank": 2},
    {"id": "high", "label": "High concern", "rank": 3},
    {"id": "critical", "label": "Critical concern", "rank": 4}
  ],
  "source_rules": [
    {
      "rule_id": "nara-native-risk",
      "source_match": {
        "source_id": "nara_digital_preservation_framework"
      },
      "role": "risk_assessment",
      "value_fields": ["native_label", "normalized_band", "semantic_level"],
      "value_map": {
        "low risk": "low",
        "low": "low",
        "moderate risk": "moderate",
        "moderate": "moderate",
        "high risk": "high",
        "high": "high"
      },
      "accept_existing_semantic_level": true,
      "default_scope": "exact_format"
    },
    {
      "rule_id": "dpc-global-bit-list",
      "source_match": {
        "source_type": "dpc_bit_list"
      },
      "role": "risk_assessment",
      "value_fields": ["native_label", "semantic_level"],
      "value_map": {
        "lower risk": "minimal",
        "lower-risk": "minimal",
        "vulnerable": "moderate",
        "endangered": "high",
        "critically endangered": "critical",
        "critically-endangered": "critical",
        "practically extinct": "critical",
        "practically-extinct": "critical"
      },
      "accept_existing_semantic_level": true,
      "default_scope": "format_group"
    },
    {
      "rule_id": "pre-normalized-risk-fallback",
      "source_match": {},
      "role": "risk_assessment",
      "value_fields": ["semantic_level"],
      "value_map": {},
      "accept_existing_semantic_level": true
    }
  ],
  "evidence_source_roles": [
    {
      "source_match": {"source_id": "loc"},
      "role": "supporting_preservation_evidence",
      "may_create_source_overall_rating": false
    },
    {
      "source_match": {"source_type": "loc_fdd_xml"},
      "role": "supporting_preservation_evidence",
      "may_create_source_overall_rating": false
    },
    {
      "source_match": {"source_id": "pronom"},
      "role": "identity_and_identification_evidence",
      "may_create_source_overall_rating": false
    },
    {
      "source_match": {"source_type": "pronom"},
      "role": "identity_and_identification_evidence",
      "may_create_source_overall_rating": false
    },
    {
      "source_match": {"source_id": "wikidata"},
      "role": "context_only",
      "may_create_source_overall_rating": false
    }
  ],
  "synthesis": {
    "missing_assessment_policy": "exclude",
    "unmapped_assessment_policy": "retain_for_ai_or_review",
    "scope_precedence": [
      ["exact_format", "format_version", "institutional_format"],
      ["format_family", "family"],
      ["format_group", "group"],
      ["content_type"],
      ["contextual"]
    ],
    "scope_selection": "most_specific_available",
    "same_scope_aggregation": "highest_semantic_concern",
    "broader_scope_policy": "context_only",
    "numeric_aggregation": "forbidden_across_source_scales"
  },
  "ai": {
    "enabled_when_ai_mode_is_on": true,
    "strategy": "interpret_unmapped_then_policy_synthesize",
    "allow_general_knowledge": false,
    "allow_web_knowledge": false,
    "require_evidence_refs": true,
    "configured_source_mappings_are_binding": true,
    "unmapped_source_risk_policy": "interpret_with_ai",
    "supporting_evidence_policy": "may_synthesize_only_when_no_mapped_source_level_assessment_exists",
    "missing_evidence_policy": "exclude",
    "scope_policy": "obey_configured_scope_precedence",
    "numeric_aggregation": "forbidden_across_source_scales"
  }
}
