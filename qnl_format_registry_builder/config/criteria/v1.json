{
  "criteria_version": "v1",
  "criteria": {
    "sustainability.disclosure": {
      "kind": "ordinal",
      "values": [
        "public_specification",
        "partial_specification",
        "proprietary_documented",
        "undocumented"
      ],
      "null_value": "unknown"
    },
    "sustainability.standardization": {
      "kind": "ordinal",
      "values": [
        "international_standard",
        "community_or_de_facto_standard",
        "not_standardized"
      ],
      "null_value": "unknown"
    },
    "sustainability.specification_currency": {
      "kind": "ordinal",
      "values": [
        "current_or_recent",
        "dated",
        "stale_or_legacy"
      ],
      "null_value": "unknown"
    },
    "sustainability.adoption": {
      "kind": "ordinal",
      "values": [
        "very_high",
        "high",
        "moderate",
        "low",
        "negligible"
      ],
      "null_value": "unknown"
    },
    "sustainability.maintenance": {
      "kind": "ordinal",
      "values": [
        "actively_maintained",
        "partially_maintained",
        "not_maintained"
      ],
      "null_value": "unknown"
    },
    "sustainability.community_guidance": {
      "kind": "ordinal",
      "values": [
        "recommended_or_neutral",
        "caution",
        "identified_to_avoid"
      ],
      "null_value": "unknown"
    },
    "sustainability.transparency_readability": {
      "kind": "ordinal",
      "values": [
        "transparent",
        "partially_transparent",
        "opaque",
        "requires_specialist_tools"
      ],
      "null_value": "unknown"
    },
    "sustainability.self_documentation": {
      "kind": "ordinal",
      "values": [
        "self_describing",
        "partially_self_describing",
        "externally_documented",
        "not_self_describing"
      ],
      "null_value": "unknown"
    },
    "sustainability.external_dependencies": {
      "kind": "ordinal",
      "values": [
        "none",
        "low",
        "moderate",
        "high"
      ],
      "null_value": "unknown"
    },
    "sustainability.ip_licensing": {
      "kind": "ordinal",
      "values": [
        "no_known_barrier",
        "limited_or_unclear",
        "known_constraint"
      ],
      "null_value": "unknown"
    },
    "sustainability.tpm_encryption": {
      "kind": "ordinal",
      "values": [
        "none_or_not_applicable",
        "possible",
        "known_constraint"
      ],
      "null_value": "unknown"
    },
    "technical.identifiability": {
      "kind": "ordinal",
      "values": [
        "authoritative_signature",
        "partial_or_non_authoritative_signature",
        "no_authoritative_signature"
      ],
      "null_value": "unknown"
    },
    "technical.container_complexity": {
      "kind": "nominal",
      "values": [
        "flat",
        "compound",
        "wrapper",
        "complex_domain_structure"
      ],
      "null_value": "unknown"
    },
    "technical.compression": {
      "kind": "nominal",
      "values": [
        "none_or_standard",
        "tool_supported",
        "specialist_or_untested"
      ],
      "null_value": "unknown"
    },
    "technical.lossy_compression": {
      "kind": "ordinal",
      "values": [
        "none_or_not_applicable",
        "possible_or_lossy"
      ],
      "null_value": "unknown"
    },
    "technical.embedded_data_support": {
      "kind": "ordinal",
      "values": [
        "none_or_not_supported",
        "supports_declared_or_hidden_data"
      ],
      "null_value": "unknown"
    },
    "technical.embedded_data_documentation": {
      "kind": "ordinal",
      "values": [
        "documented",
        "not_applicable",
        "undocumented"
      ],
      "null_value": "unknown"
    },
    "technical.metadata_extensibility": {
      "kind": "ordinal",
      "values": [
        "supports_embedded_metadata",
        "limited_or_external_metadata",
        "no_embedded_metadata_support"
      ],
      "null_value": "unknown"
    },
    "technical.hardware_dependency": {
      "kind": "ordinal",
      "values": [
        "none",
        "low",
        "moderate",
        "high"
      ],
      "null_value": "unknown"
    },
    "technical.renderer_availability": {
      "kind": "ordinal",
      "values": [
        "renderers_available",
        "limited_or_unknown",
        "no_known_renderer"
      ],
      "null_value": "unknown"
    },
    "technical.open_source_tooling": {
      "kind": "ordinal",
      "values": [
        "open_source_available",
        "no_open_source_tooling"
      ],
      "null_value": "unknown"
    },
    "technical.plugin_script_dependency": {
      "kind": "ordinal",
      "values": [
        "none",
        "low",
        "moderate",
        "high"
      ],
      "null_value": "unknown"
    },
    "technical.operating_system_support": {
      "kind": "ordinal",
      "values": [
        "cross_platform",
        "limited_platform_support"
      ],
      "null_value": "unknown"
    },
    "technical.creation_software_support": {
      "kind": "ordinal",
      "values": [
        "currently_supported",
        "unsupported_or_legacy"
      ],
      "null_value": "unknown"
    },
    "technical.accessibility_features": {
      "kind": "nominal",
      "values": [
        "supports_accessibility_features",
        "not_applicable",
        "requires_format_specific_strategy"
      ],
      "null_value": "unknown"
    },
    "source.currency": {
      "kind": "temporal",
      "unit": "days_since_update",
      "null_value": "unknown"
    }
  },
  "reconciliation": {
    "defaults": {
      "policy": "highest_directness_then_independence",
      "on_disagreement": "use_reconciled",
      "tolerance": 1,
      "escalate_when": {
        "distance": ">=2"
      }
    },
    "overrides": {
      "technical.container_complexity": {
        "tolerance": 0
      }
    }
  }
}
