    "loc": {
      "strength": "strong",
      "verified_from": [
        "loc_fdd_xml"
      ]
    },
    "nara": {
      "strength": "strong",
      "verified_from": [
        "nara_digital_preservation_framework",
        "nara_preservation_csv"
      ]
    },
    "wikidata": {
      "strength": "weak",
      "verified_from": []
    }
  },
  "sources": [
    {
      "id": "nara_digital_preservation_framework",
      "type": "nara_digital_preservation_framework",
      "enabled": true,
      "required": true,
      "retrieval_mode": "published_csv",
      "release_mode": "pinned",
      "release_date": "20260320",
      "github_ref": "master",
      "notes": "Drop the two release CSVs in input/nara_digital_preservation_framework/ to run without the network; otherwise the pinned release is fetched from raw.githubusercontent.com."
    }
  ]
