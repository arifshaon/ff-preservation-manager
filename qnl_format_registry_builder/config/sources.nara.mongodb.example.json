{
  "pipeline_version": "0.1.0",
  "incremental_source_updates": true,
  "storage": {
    "type": "mongodb",
    "uri": "mongodb://localhost:27017",
    "database": "format_registry"
  },
  "exports": {
    "enabled": true
  },
  "method_profiles": {
    "enabled": true,
    "path": "method_profiles.example.json"
  },
  "criterion_mapping": {
    "enabled": true,
    "mode": "apply",
    "criteria": "criteria/v1.json",
    "mappings": "criterion_mappings",
    "include_drafts": false,
    "scope": "all",
    "notes": "Source-scoped operational config for adding or refreshing NARA. Reconciliation still uses latest stored records from other completed sources."
  },
  "identifier_kinds": {
    "puid": {"strength": "strong", "verified_from": ["pronom_registry", "pronom_droid_xml", "wikidata"]},
    "loc": {"strength": "strong", "verified_from": ["loc_fdd_xml"]},
    "nara": {"strength": "strong", "verified_from": ["nara_digital_preservation_framework", "nara_preservation_csv"]},
    "wikidata": {"strength": "weak", "verified_from": ["wikidata"]}
  },
  "sources": [
    {
      "id": "nara_digital_preservation_framework",
      "type": "nara_digital_preservation_framework",
      "enabled": true,
      "required": true,
      "retrieval_mode": "published_csv",
      "release_mode": "pinned",
      "release_date": "20260320",
      "fallback_release_date": "20260320",
      "github_ref": "master",
      "fallback_local_files": [],
      "notes": "NARA is useful as an identity, preservation-planning, and external hazard source. Criterion claims are generated only for accepted NARA rubric-answer mappings; composite NARA ratings remain hazard estimators."
    }
  ]
}
