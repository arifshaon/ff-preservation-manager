        "Opaque": "opaque",
        "Unknown": "unknown"
      },
      "text_rules": [
        {
          "value": "opaque",
          "contains_any": ["opaque", "binary encoding", "not transparent"]
        },
        {
          "value": "transparent",
          "contains_any": ["human-readable", "plain text", "simple text", "can be read with simple tools", "transparent"]
        },
        {
          "value": "partially_transparent",
          "contains_any": ["partially transparent", "depends on", "requires software"]
        }
      ],
      "rationale": "LOC Transparency prose concerns whether encoding or bitstreams are open to direct analysis."
    },
