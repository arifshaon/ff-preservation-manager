    {
      "field": "loc_ids",
      "reason": "LOC FDD identifier is identity evidence, not preservation-risk criterion evidence."
    },
    {
      "field": "puids",
      "reason": "PUIDs found in LOC FDD text are identity cross-references, not sustainability criterion evidence."
    },
    {
      "field": "wikidata_ids",
      "reason": "Wikidata IDs found in LOC FDD text are identity cross-references, not sustainability criterion evidence."
