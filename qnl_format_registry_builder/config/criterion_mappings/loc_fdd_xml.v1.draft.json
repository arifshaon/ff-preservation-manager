  "notes": "Full LOC draft mapping. LOC FDD sustainability factors are extracted as source-native prose under native_fields.sustainability_factors. Criterion values are produced only by explicit value mappings or transparent text_rules in this file.",
  "excluded_from_criteria": [
    {
