  "maps": [
    {
      "id": "loc.disclosure.from_sustainability_factor.v1",
      "criterion": "sustainability.disclosure",
      "from_field": "native_fields.sustainability_factors.disclosure",
      "directness": "derived",
      "covers": "partial",
      "source_independence": "independent",
      "mapping_status": "needs_review",
      "values": {
        "Full": "public_specification",
        "Partial": "partial_specification",
        "Minimal": "proprietary_documented",
        "No": "undocumented",
        "Unknown": "unknown"
      },
      "text_rules": [
        {
          "value": "undocumented",
          "contains_any": ["not documented", "undocumented", "no specification", "little documentation"]
        },
        {
          "value": "public_specification",
          "contains_any": ["fully disclosed", "fully documented", "open standard", "publicly available specification", "published specification", "complete documentation", "specification is available"]
        },
        {
          "value": "proprietary_documented",
          "contains_any": ["proprietary format", "documentation requires purchase", "specification requires purchase", "documentation is available for purchase"]
        },
        {
          "value": "partial_specification",
          "contains_any": ["partially disclosed", "limited documentation", "some documentation", "documentation is available"]
        }
      ],
      "rationale": "LOC Disclosure prose is source evidence about technical information and documentation availability. Text rules are conservative phrase mappings and remain transparent in the mapping file."
    },
    {
      "id": "loc.adoption.from_sustainability_factor.v1",
      "criterion": "sustainability.adoption",
      "from_field": "native_fields.sustainability_factors.adoption",
      "directness": "derived",
      "covers": "partial",
      "source_independence": "independent",
      "mapping_status": "needs_review",
      "values": {
        "Very High": "very_high",
        "High": "high",
        "Moderate": "moderate",
        "Low": "low",
        "Negligible": "negligible",
        "Unknown": "unknown"
      },
      "text_rules": [
        {
          "value": "low",
          "contains_any": ["limited adoption", "little adoption", "not widely adopted", "rarely used"]
        },
        {
          "value": "very_high",
          "contains_any": ["very widely adopted", "ubiquitous", "de facto standard"]
        },
        {
          "value": "high",
          "contains_any": ["widely adopted", "widely used", "broadly used", "commonly used", "well established"]
        },
        {
          "value": "moderate",
          "contains_any": ["some adoption", "moderate adoption", "used in some", "niche adoption"]
        }
      ],
      "rationale": "LOC Adoption prose describes implementation and use. Claims are derived only when common phrases give a clear adoption signal."
    },
    {
