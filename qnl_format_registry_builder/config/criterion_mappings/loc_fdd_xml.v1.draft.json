      "covers": "partial",
      "source_independence": "independent",
      "mapping_status": "needs_review",
      "values": {
        "None": "none",
        "None.": "none",
        "Low": "low",
        "Moderate": "moderate",
        "High": "high",
        "Unknown": "unknown"
      },
      "text_rules": [
        {
          "value": "none",
          "equals_any": ["None", "None."]
        },
        {
          "value": "high",
          "contains_any": ["requires specific hardware", "requires proprietary software", "depends on proprietary", "requires external software"]
        },
        {
          "value": "moderate",
          "contains_any": ["requires software", "specialized software", "specific software"]
        },
        {
          "value": "low",
          "contains_any": ["some dependency", "minor dependency", "limited dependency", "fonts be embedded", "fonts are embedded", "font embedding"]
        }
      ],
      "rationale": "LOC External dependencies prose describes need for external software or hardware. Embedded-font dependencies are mapped as low because the dependency is conditional and can be internalized in the file/profile, not a standing requirement for proprietary software or specific hardware."
    },
